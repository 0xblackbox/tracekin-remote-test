{
  "description": "Tracekin detects the current project and enables the install-default stream. Type 'tracekin off' before a sensitive task to pause only that session; control prompts are not uploaded. Runs under Codex and Claude Code.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekin.py\" start",
            "timeout": 5,
            "statusMessage": "Tracekin: starting local companion"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekin.py\" hook",
            "timeout": 3,
            "statusMessage": "Tracekin: syncing unless this session is paused"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekin.py\" hook",
            "timeout": 3,
            "statusMessage": "Tracekin: applying session controls before syncing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekin.py\" hook",
            "timeout": 3,
            "statusMessage": "Tracekin: syncing unless this session is paused"
          }
        ]
      }
    ]
  }
}
