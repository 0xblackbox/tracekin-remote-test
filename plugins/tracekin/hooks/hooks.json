{
  "description": "Tracekin detects the current project, then shares only after an explicit panel or MCP allow choice. Type 'tracekin off' before a sensitive task to pause only that Codex session; control prompts are not uploaded.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/tracekin.py start",
            "timeout": 3,
            "statusMessage": "Tracekin: starting local companion"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/tracekin.py hook",
            "timeout": 3,
            "statusMessage": "Tracekin: recording unless this session is paused"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/tracekin.py hook",
            "timeout": 3,
            "statusMessage": "Tracekin: applying session controls before recording"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/tracekin.py hook",
            "timeout": 3,
            "statusMessage": "Tracekin: recording unless this session is paused"
          }
        ]
      }
    ]
  }
}
